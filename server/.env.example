# Copy this file to ".env" and fill it in.

PORT=5000

# MongoDB connection string (MongoDB Atlas or your own server).
# Leave it empty to store everything in server/data/db.json instead.
# That file mode is handy on your own laptop, use MongoDB for the real site.
MONGODB_URI=

# Any long random text. Keep it secret. Changing it logs the admin out.
JWT_SECRET=change-me-to-a-long-random-string

# The one admin account. It is created the first time the server starts.
# After that, change the password from the admin panel (Account page).
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-password

# Only needed when the website and this server are on different addresses.
# CLIENT_ORIGIN = address of the website, PUBLIC_URL = address of this server.
# CLIENT_ORIGIN can list more than one address, separated by commas, for
# example both "https://example.com" and "https://www.example.com".
CLIENT_ORIGIN=
PUBLIC_URL=

# Optional. Fill in all three to store uploaded photos/PDFs on Cloudinary
# (cloudinary.com, has a free plan) instead of this server's own disk.
# Use this on any host whose disk is wiped on each deploy (most app
# hosts work this way) — otherwise uploaded files disappear next deploy.
# Leave blank to keep using local disk, which is fine for development.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
