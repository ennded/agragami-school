# Copy this file to ".env" and fill it in.

PORT=5000

# MongoDB connection string (MongoDB Atlas or your own server).
# Leave it empty to store everything in server/data/db.json instead.
# That file mode is handy on your own laptop, use MongoDB for the real site.
MONGODB_URI=

# Any long random text. Keep it secret. Changing it logs the admin out.
JWT_SECRET=change-me-to-a-long-random-string

# The one admin account. It is created the first time the server starts.
# After that, change the password from the admin panel (Account page).
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-password

# Only needed when the website and this server are on different addresses.
# CLIENT_ORIGIN = address of the website, PUBLIC_URL = address of this server.
CLIENT_ORIGIN=
PUBLIC_URL=
